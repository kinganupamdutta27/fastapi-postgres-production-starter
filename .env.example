# === Database ===
DATABASE_HOST=localhost
DATABASE_PORT=6432
DATABASE_USER=app_user
DATABASE_PASSWORD=app_secret
DATABASE_NAME=app_db

# Direct PostgreSQL (bypass PgBouncer)
DATABASE_DIRECT_PORT=5432

# === Connection Pool (application-side) ===
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_MAX_INACTIVE_LIFETIME=300

# === Timeouts (seconds) ===
DB_STATEMENT_TIMEOUT=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT=10000

# === Circuit Breaker ===
CB_FAIL_MAX=5
CB_TIMEOUT_DURATION=30

# === App ===
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
APP_DEBUG=true
